# OpenJarvis Environment Configuration
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# API Keys for Cloud Models (optional - can use local models)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# -----------------------------------------------------------------------------
# CERBERUS-Specific Configuration
# -----------------------------------------------------------------------------
# Gemini API Key (required for CERBERUS V1)
GEMINI_API_KEY=your_gemini_api_key_here

# CERBERUS Model Configuration
CERBERUS_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# Gmail OAuth Configuration (required for CERBERUS email features)
# -----------------------------------------------------------------------------
# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Google OAuth Client Secret (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gmail OAuth Scopes (already configured in gmail.py, but can be overridden)
# The current implementation uses: https://www.googleapis.com/auth/gmail.modify
# which allows reading, sending, and modifying emails.

# -----------------------------------------------------------------------------
# Speech-to-Text Configuration (optional - for voice interaction)
# -----------------------------------------------------------------------------
# STT Backend: openai_whisper, faster_whisper, deepgram
STT_BACKEND=openai_whisper

# STT Model (depends on backend)
STT_MODEL=whisper-1

# Text-to-Speech Configuration (optional - for voice response)
# TTS Backend: cartesia, kokoro, openai_tts
TTS_BACKEND=cartesia

# TTS Voice ID (depends on backend)
TTS_VOICE_ID=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# CERBERUS uses SQLite databases stored in ~/.openjarvis/
# - approvals.db: ApprovalStore, decision journal, relational memory
# - prospection_log.db: Prospection agent logging
# - telemetry.db: Usage telemetry
# No additional configuration needed for SQLite.

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Server host (default: 127.0.0.1)
OPENJARVIS_HOST=127.0.0.1

# Server port (default: 8000)
OPENJARVIS_PORT=8000

# API Key for server authentication (optional but recommended)
# Generate with: jarvis auth generate-key
OPENJARVIS_API_KEY=

# -----------------------------------------------------------------------------
# Memory and Context Configuration
# -----------------------------------------------------------------------------
# Enable memory context injection
CONTEXT_FROM_MEMORY=true

# Memory context parameters
CONTEXT_TOP_K=5
CONTEXT_MIN_SCORE=0.7
CONTEXT_MAX_TOKENS=1000

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# Default agent (cerberus_conversational for CERBERUS V1)
DEFAULT_AGENT=cerberus_conversational

# Default model (can be local or cloud)
DEFAULT_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# Security and Privacy
# -----------------------------------------------------------------------------
# Never commit actual values to version control
# Keep .env file in .gitignore
# Rotate API keys regularly
# Use environment-specific configurations for production
